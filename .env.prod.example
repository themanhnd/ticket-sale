SPRING_PROFILES_ACTIVE=prod
JWT_SECRET=replace-with-strong-secret
ENCRYPT_KEY=replace-with-strong-key

MYSQL_VERSION=8.4
MYSQL_PORT=3306
MYSQL_DATABASE=user_service_db
MYSQL_ROOT_PASSWORD=replace-with-strong-password

